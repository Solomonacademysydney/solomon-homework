{
  "database": {
    "// 주의": "이 저장소는 공개(PUBLIC)다. 규칙 파일에는 원장 계정 uid와 어느 경로가 열려 있는지가 그대로 담기므로 저장소에 올리지 않는다. backup/ 은 .gitignore 대상이라 여기 둔다. 배포 전 현재 규칙은 backup/database.rules.CURRENT_*.json 으로 받아둘 것 (firebase database:get /.settings/rules).",
    "rules": "backup/database.rules.json"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "**/*.bak",
      "**/*.backup*",
      "**/*.bak.*",
      "**/*.checkpoint*",
      "backup/**",
      "functions/**"
    ],
    "headers": [
      {
        "source": "/index.html",
        "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }]
      }
    ]
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local",
        "*.test.js",
        "*.backup-*"
      ]
    }
  ],
  "emulators": {
    "// 주의": "시험용이다. 운영에는 아무 영향이 없다 — `firebase emulators:start` 를 칠 때만 뜬다. 학생 화면은 운영 config 가 박혀 있어 못 옮긴다(일꾼·함수·규칙 시험용).",
    "database": { "port": 9000 },
    "functions": { "port": 5001 },
    "ui": { "enabled": true, "port": 4000 },
    "singleProjectMode": true
  }
}
